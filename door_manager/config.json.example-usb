{
    "door-id": "1234",
    "mqtt": {
        "client_kwargs": {
            "transport": "tcp"
        },
        "password_auth": {
            "username": "test",
            "password": "test"
        },
        "server_kwargs": {
            "host": "127.0.0.1",
            "port": 8001,
            "keepalive": 10
        },
        "tls": false
    },
    "gpio-config": "usb",
    "usb-path": "/dev/serial/by-id/usb-MicroPython_Board_in_FS_mode_e6616407e325ac25-if00",
    "input-type": "dormakaba_ed_100_250",
    "open-time": 1,
    "open-gpios": {"out3": "H"},
    "day-gpio": "out2",
    "night-gpio": "out1",
    "permaopen-input": "in3",
    "loglevel": "ERROR",
    "inactive-outputs": {"others": "Z"},
    "programs": {
        "closed": {"out1": "H"},
        "manual": {"out2": "H"},
        "exitonly": {"out4": "H"},
        "bothways": {"out5": "H"},
        "permaopen": {"out6": "H"}
    },
    "program-change": "cycle",
    "cycle-programs": ["closed", "manual", "exitonly", "bothways", "permaopen"],
    "cycle-forward-input": "in1",
    "cycle-backward-input": "in2"
}
